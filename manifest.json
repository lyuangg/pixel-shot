{
  "manifest_version": 3,
  "name": "Precise Size Screenshot",
  "version": "1.0.0",
  "description": "Set browser viewport to preset sizes and capture screenshots with exact pixel dimensions.",
  "permissions": ["tabs", "activeTab", "storage", "downloads"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Precise Size Screenshot"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
